rules_version = '2';

// Street Signal rules for the mobile app. The .NET dashboard uses a service
// account, which bypasses these rules, so it enforces the same checks in C#.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Private to the signed-in person.
    match /users/{uid} {
      allow read, write: if isMe(uid);
    }
    match /households/{uid} {
      allow read, write: if isMe(uid);
      match /{sub=**} {
        allow read, write: if isMe(uid);
      }
    }

    // Shared within the area. You can only report as yourself, and only
    // change your own report's "back on" time.
    match /reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.service in ['water', 'electricity'];
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restoredAt', 'durationMinutes']);
    }

    // A light list of areas (name + ward) for the dashboard's area picker.
    match /areas/{areaId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['name', 'ward', 'updatedAt']);
    }

    // Community posts. Anyone signed in can read and post as themselves.
    // The owner can close or edit their post; everyone else can only add or
    // remove themselves from `members` ("Join", "I'm interested").
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.sector in ['food', 'energy', 'water', 'transport', 'prepare'];
      allow update: if signedIn() && (
                      (resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid)
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
                        && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])));
    }

    // Emergency needs live under households/{uid}/needs and are covered by
    // the private household rule above: only the owner can read them.

    // Alerts and incidents are written by the .NET backend only.
    match /alerts/{id} { allow read: if signedIn(); allow write: if false; }
    match /incidents/{id} { allow read: if signedIn(); allow write: if false; }
  }
}
